# ── Frontend ──────────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.cache/

# ── Python / Backend ──────────────────────────────────────────────────────────
**/__pycache__/
**/*.pyc
**/*.pyo
backend/venv/
backend/.venv/
backend/.pytest_cache/

# ── Databases ─────────────────────────────────────────────────────────────────
# Exclude SQLite databases everywhere (generated at runtime)
*.db
*.db.bak
*.sqlite
*.sqlite3

# ── Alembic ───────────────────────────────────────────────────────────────────
# Track alembic.ini and migrations — do NOT gitignore them
# (Alembic's __pycache__ is covered by **/__pycache__/ above)

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.env
*.pem
*.key
*.crt

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
backend/*.log

# ── Test / coverage artifacts ─────────────────────────────────────────────────
.coverage
.cache/
htmlcov/

# ── IDE / OS ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
NUL

# ── Claude Code internal ──────────────────────────────────────────────────────
.claude/

# ── Misc project files ────────────────────────────────────────────────────────
Prompt.txt

# ── Markdown (project policy: track only README) ─────────────────────────────
*.md
!README.md
